// Jewels by Richa — PLANNED database schema (not wired up yet).
// Mirrors the Treasure Trove schema, plus a Collection level above Category.
// To activate: `npm i prisma @prisma/client`, set DATABASE_URL, run `npx prisma migrate dev --name init`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum ProductStatus {
  ACTIVE
  DRAFT
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  UPI
  CARD
  COD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum DiscountType {
  PERCENT
  FLAT
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now())

  addresses Address[]
  orders    Order[]
  wishlist  WishlistItem[]
  reviews   Review[]
}

model Address {
  id        String  @id @default(cuid())
  userId    String
  name      String
  phone     String
  line      String
  city      String
  state     String
  pincode   String
  isDefault Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Top level of the catalogue: "Festive Collection", "Anti Tarnish"
model Collection {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  tagline     String?
  description String?
  imageUrl    String?
  sortOrder   Int        @default(0)
  categories  Category[]
  products    Product[]
}

// "Heritage Bangle Kada", "Hoop Earrings", …
model Category {
  id           String     @id @default(cuid())
  collectionId String
  name         String
  slug         String     @unique
  description  String?
  imageUrl     String?
  sortOrder    Int        @default(0)
  active       Boolean    @default(true)
  collection   Collection @relation(fields: [collectionId], references: [id])
  products     Product[]

  @@index([collectionId])
}

model Product {
  id               String        @id @default(cuid())
  name             String
  slug             String        @unique
  collectionId     String
  categoryId       String
  price            Int // rupees (whole numbers), as in Treasure Trove
  originalPrice    Int? // MRP, shows the discount
  shortDescription String?
  description      String
  material         String?
  careInstructions String?
  features         String[]
  stock            Int           @default(0)
  status           ProductStatus @default(ACTIVE)
  isFeatured       Boolean       @default(false)
  isBestSeller     Boolean       @default(false)
  isNew            Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  collection Collection     @relation(fields: [collectionId], references: [id])
  category   Category       @relation(fields: [categoryId], references: [id])
  images     ProductImage[]
  orderItems OrderItem[]
  wishlist   WishlistItem[]
  reviews    Review[]

  @@index([categoryId])
  @@index([collectionId])
  @@index([status])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String // Cloudinary URL
  publicId  String? // Cloudinary id, for deletes
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Order {
  id             String        @id @default(cuid())
  number         String        @unique // "JBR-1001"
  userId         String? // null for guest checkout
  // Snapshots — never FKs — so history survives edits
  customerName   String
  email          String
  phone          String
  shippingAddress Json
  subtotal       Int
  discount       Int           @default(0)
  shipping       Int           @default(0)
  codFee         Int           @default(0)
  total          Int
  couponCode     String?
  paymentMethod  PaymentMethod
  paymentStatus  PaymentStatus @default(PENDING)
  status         OrderStatus   @default(PENDING)
  trackingNumber String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user     User?       @relation(fields: [userId], references: [id])
  items    OrderItem[]
  payments Payment[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String?
  name      String // snapshot
  price     Int // snapshot
  quantity  Int
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String
  provider          String        @default("razorpay")
  providerOrderId   String?       @unique
  providerPaymentId String?       @unique
  amount            Int
  status            PaymentStatus @default(PENDING)
  createdAt         DateTime      @default(now())
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model WebhookEvent {
  id          String   @id // provider event id — makes webhook handling idempotent
  type        String
  processedAt DateTime @default(now())
}

model Coupon {
  id          String       @id @default(cuid())
  code        String       @unique
  description String?
  type        DiscountType
  value       Int
  minOrder    Int          @default(0)
  maxDiscount Int?
  usageLimit  Int?
  usedCount   Int          @default(0)
  expiresAt   DateTime
  active      Boolean      @default(true)
  codAllowed  Boolean      @default(true)
  createdAt   DateTime     @default(now())
}

model WishlistItem {
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
}

model Review {
  id        String   @id @default(cuid())
  productId String
  userId    String
  rating    Int
  comment   String?
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// Auth support (same approach as Treasure Trove)
model VerificationCode {
  key       String   @id // "<email>:<purpose>"
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
}

model RateLimit {
  key      String   @id
  points   Int      @default(0)
  expireAt DateTime
}

model SiteSettings {
  key   String @id
  value Json
}
